generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  imageUrl  String
  stock     Int      @default(0)
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
